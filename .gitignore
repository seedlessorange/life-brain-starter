# Generated pages — rebuilt from markdown, committing them just churns history
brain/index.html
brain/map.html
brain/rooms.html
brain/archive/desk-prototype/proto.html
brain/synced.md
# Derived graph index — rebuilt from the markdown whenever it is older
brain/graph.db
brain/graph.db.tmp
# Runtime droppings
brain/.agent-log.jsonl
nohup.out
*.log
__pycache__/
.DS_Store
brain/.morning.log
brain/.morning-launchd.log
.gstack/
brain/.agent-runs.json
brain/files/
brain/.beeper-client.json
.beeper-token
# Telegram bridge credentials — the token never enters history
brain/.telegram.json
# Calendar feed addresses are keys (anyone holding one can read the calendar)
brain/.calendar-feeds
brain/transcripts/.fw-lock
# Transcription scratch — a 187MB intermediate wav here once blocked every
# push for weeks (GitHub's 100MB limit), which silently killed the backup.
brain/transcripts/.work/
brain/.beeper-review.json
brain/.calendar-cache.json
# Contact photos and daily-ration state — personal, local-only
brain/avatars/
brain/.today-five.json
brain/.reconnect.json
brain/.map-history.json
# Share packages — generated by share.py, never committed
dist/
brain/.voice/
# Kokoro, the brain's voice: its own Python environment and ~340 MB of model
# files (voice.py). Installed on her go-ahead, 28 Sep; never committed.
brain/.speech/
# The blueprints (blueprints.py): regenerated from live data, never committed.
brain/blueprints/
# The plan meter's last answer (plan_usage.py): a snapshot, refetched every
# few minutes, worth nothing as history.
brain/.plan-usage.json
# Night shift runtime droppings. The report is regenerated every night and the
# result files exist only while a job is running.
brain/.night-report.md
brain/.night-result.json
brain/.morning-result.json
# brain/.usage.jsonl is deliberately NOT ignored. It is the account of what the
# brain has spent, and it is the one thing here that is only useful as history
# — ignoring it would mean a reset or a reclone silently zeroes the record.
# It is a dotfile, so share.py never packages it.
brain/finance/
# Venture meeting recordings: raw audio of the team, large, and nobody
# else's to publish, so the sound files never reach GitHub. The transcripts
# beside them are part of the brain's record and do go in.
brain/school/venture-recordings/*.m4a
brain/school/venture-recordings/*.mp3
brain/school/venture-recordings/*.wav
brain/school/venture-recordings/*.m4v
brain/school/venture-recordings/.DS_Store
brain/appearance.css
brain/.unattended
brain/.private-locked
brain/.plan-undo.json
brain/.last-sweep
# The recipe library — 520MB of extracted cookbooks and photos, static data,
# never edited, so git gains nothing by holding it. cook-data.json and the
# index cache regenerate from it.
brain/recipes-library/
brain/cook-data.json
brain/cooking/.recipes.json
brain/cook.html
brain/routines.html
# Notion row bodies, cached so the morning pull stays cheap. Regenerable,
# and a copy of her notes does not need a second home in git history.
brain/.notion-cache.json
# The class tracker's last comparison, so the page never waits on Google.
brain/.tracker-cache.json
# Study guide reading progress and background book-build jobs: runtime state.
brain/school/guides/.progress.json
brain/school/guides/.jobs.json
brain/school/guides/.jobs/
.book-notes/
# Per-run Claude settings, regenerated at every launch (run_policy.py)
brain/tools/.run-policy/
# Word/Office lock files while a document is open
~$*
# Page-build caches: the calendar list and recording lengths, both regenerable
brain/.calendar-list.json
brain/.transcribe-lengths.json

# For you, as the box reads it on every page — rebuilt with the page
brain/.tray.json
# The last mail check: who wrote, from headers — runtime state, not history
brain/.email-read.json
# The twice-daily recordings pass: its last run
brain/.recordings-auto.json
# Built by brain/tools/make_brain_app.sh; holds Full Disk Access on this Mac
Brain Server.app/
brain/.serve.pid
brain/archive/old-launcher/
# The Touch ID mail gate, built locally by make_brainmail.sh
brain/tools/.bin/
